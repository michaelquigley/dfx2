diff --git a/experiments/webkitgtk-spike/exitwatch.py b/experiments/webkitgtk-spike/exitwatch.py
index 5e355fd..f0e441d 100644
--- a/experiments/webkitgtk-spike/exitwatch.py
+++ b/experiments/webkitgtk-spike/exitwatch.py
@@ -51,8 +51,9 @@ def descendants(root, seen):
             pass
 
 
-def observe(proc, timeout=120, child_timeout=15):
-    seen = {}
+def observe(proc, timeout=120, child_timeout=15, seen=None):
+    """seen may carry identities a caller sampled while the host ran."""
+    seen = {} if seen is None else seen
     started = time.monotonic()
     deadline = started + timeout
     timed_out = False
@@ -71,10 +72,20 @@ def observe(proc, timeout=120, child_timeout=15):
     while True:
         descendants(os.getpid(), seen)
         try:
-            pid, status = os.waitpid(-1, os.WNOHANG)
+            # Peek first: an adopted child that exited unsampled is still a
+            # zombie, and its comm can name it before it is reaped.
+            info = os.waitid(os.P_ALL, 0, os.WEXITED | os.WNOHANG | os.WNOWAIT)
         except ChildProcessError:
             break
+        pid = info.si_pid if info else 0
+        if pid and pid not in seen:
+            try:
+                name = Path(f"/proc/{pid}/comm").read_text().strip()
+                seen[pid] = {"pid": pid, "name": name, "command": "", "libraries": [], "identified_from": "zombie comm"}
+            except (FileNotFoundError, ProcessLookupError, PermissionError):
+                pass
         if pid:
+            _, status = os.waitpid(pid, 0)
             exits.append({**seen.get(pid, {"pid": pid, "name": "unobserved"}),
                           "exit": os.waitstatus_to_exitcode(status),
                           "core_dumped": os.WCOREDUMP(status)})
diff --git a/experiments/webkitgtk-spike/host_linux.go b/experiments/webkitgtk-spike/host_linux.go
index 13c42b9..a7a235b 100644
--- a/experiments/webkitgtk-spike/host_linux.go
+++ b/experiments/webkitgtk-spike/host_linux.go
@@ -93,10 +93,11 @@ func installCallbacks() {
 // g_idle_add_full always queues onto the main context. g_main_context_invoke
 // is unsuitable: it may execute synchronously on the calling worker.
 type poster struct {
-	mu     sync.Mutex
-	closed bool
-	source uint32
-	queue  []func()
+	mu       sync.Mutex
+	closed   bool
+	source   uint32
+	queue    []func()
+	callback uintptr // the idle trampoline; callbacks.one when zero
 }
 
 func (p *poster) post(f func()) bool {
@@ -109,7 +110,11 @@ func (p *poster) post(f func()) bool {
 		p.queue = append(p.queue, f)
 	}
 	if p.source == 0 {
-		p.source = n.gIdleAddFull(0, callbacks.one, 0, 0)
+		cb := p.callback
+		if cb == 0 {
+			cb = callbacks.one
+		}
+		p.source = n.gIdleAddFull(0, cb, 0, 0)
 	}
 	return p.source != 0
 }
